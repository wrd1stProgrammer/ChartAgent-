CHARTAGENT_APP_ENV=production
CHARTAGENT_IMAGE=wrd1stprogrammer/chartagent:latest
CHARTAGENT_OPENAI_API_KEY=
INSIGHTSENTRY_RAPIDAPI_KEY=
INSIGHTSENTRY_RAPIDAPI_HOST=insightsentry.p.rapidapi.com
CHARTAGENT_CODEX_BINARY=/usr/local/bin/codex
CHARTAGENT_CODEX_TIMEOUT_SECONDS=55
CHARTAGENT_CODEX_MAX_CONCURRENCY=2
CODEX_HOME=/home/app/.codex
SHARED_CODEX_VOLUME=facemaxx_codex-home
CHARTAGENT_ANNOTATION_MODEL=gpt-6-astra
CHARTAGENT_ANNOTATION_MAX_CONCURRENCY=2
CHARTAGENT_ANNOTATIONS_ENABLED=true
CHARTAGENT_ANNOTATION_PROVIDER=codex_cli
