// Copy the Apple public SDK key from RevenueCat Project Settings > API keys.
REVENUECAT_API_KEY = appl_REPLACE_WITH_YOUR_PUBLIC_IOS_SDK_KEY

// Copy the app name and iOS SDK token from Airbridge > Settings > Tokens.
AIRBRIDGE_APP_NAME = REPLACE_WITH_YOUR_AIRBRIDGE_APP_NAME
AIRBRIDGE_SDK_TOKEN = REPLACE_WITH_YOUR_AIRBRIDGE_IOS_SDK_TOKEN

// Meta Events Manager / App Dashboard values.
META_APP_ID = REPLACE_WITH_META_APP_ID
META_CLIENT_TOKEN = REPLACE_WITH_META_CLIENT_TOKEN

// TikTok App Events SDK values.
// APPLICATION_ID is the numeric application ID from TikTok's Marketing API dashboard.
// APP_ID is the numeric TikTok App ID generated in Events Manager.
TIKTOK_APPLICATION_ID = REPLACE_WITH_TIKTOK_APPLICATION_ID
TIKTOK_APP_ID = REPLACE_WITH_TIKTOK_APP_ID
TIKTOK_ACCESS_TOKEN = REPLACE_WITH_TIKTOK_ACCESS_TOKEN
