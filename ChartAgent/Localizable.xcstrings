          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que les preuves s’accumulent,\nles décisions deviennent plus claires."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que les preuves s’accumulent,\nles décisions deviennent plus claires."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
