    "연속 캔들의 몸통 크기, 꼬리, 진행 속도와 화면에 보이는 거래량만 비교해 매수·매도 힘이 가속되는지 약해지는지 판정합니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht sichtbare Kerzenkörper, Dochte, Tempo und Volumen, um zu beurteilen, ob der Kauf- oder Verkaufsdruck zunimmt oder nachlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares visible candle bodies, wicks, pace, and volume to judge whether buying or selling pressure is accelerating or fading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara los cuerpos, las mechas, el ritmo y el volumen de las velas visibles para juzgar si la presión de compra o venta se está acelerando o disminuyendo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara los cuerpos, las mechas, el ritmo y el volumen de las velas visibles para juzgar si la presión de compra o venta se está acelerando o disminuyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare les corps de bougies visibles, les mèches, le rythme et le volume pour juger si la pression d'achat ou de vente s'accélère ou s'atténue."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare les corps de bougies visibles, les mèches, le rythme et le volume pour juger si la pression d'achat ou de vente s'accélère ou s'atténue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan badan candle yang terlihat, sumbu, kecepatan, dan volume untuk menilai apakah tekanan beli atau jual semakin cepat atau memudar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta i corpi delle candele visibili, gli stoppini, il ritmo e il volume per giudicare se la pressione di acquisto o di vendita sta accelerando o attenuandosi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目に見えるローソク体、芯、ペース、出来高を比較して、買い圧力または売り圧力が加速しているか弱まっているかを判断します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연속 캔들의 몸통 크기, 꼬리, 진행 속도와 화면에 보이는 거래량만 비교해 매수·매도 힘이 가속되는지 약해지는지 판정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara corpos visíveis de velas, pavios, ritmo e volume para avaliar se a pressão de compra ou venda está acelerando ou diminuindo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบตัวแท่งเทียน ไส้เทียน อัตราก้าว และปริมาตรที่มองเห็นได้ เพื่อตัดสินว่าแรงกดดันในการซื้อหรือขายกำลังเพิ่มขึ้นหรือลดลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alım veya satım baskısının hızlanıp artmadığını veya azaldığını yargılamak için görünen mum gövdelerini, fitillerini, hızını ve hacmini karşılaştırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh thân nến, bấc, tốc độ và khối lượng nến có thể nhìn thấy để đánh giá xem áp lực mua hoặc bán đang tăng tốc hay giảm dần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较可见的蜡烛实体、影线、节奏和成交量，以判断买入或卖出压力是否正在加速或减弱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較可見的蠟燭實體、影線、節奏和成交量，以判斷買入或賣出壓力是否正在加速或減弱。"
          }
        }
      }
    },
    "예: 짧고 단호하게" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z. B. kurz und bestimmt"
          }
        },
