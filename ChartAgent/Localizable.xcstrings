          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five agents analyze independently, challenge one another,\nand leave only actionable conditions in one report."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco agentes analizan de forma independiente, se desafían entre sí\ny dejan solo condiciones procesables en un informe."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
