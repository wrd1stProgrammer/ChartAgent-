    "근거가 쌓일수록\n판단은 더 선명해져요." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Zusammenführung von Beweisen werden\nEntscheidungen klarer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As evidence compounds,\ndecisions become clearer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que la evidencia se acumula,\nlas decisiones se vuelven más claras."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
