    "몸통 확장과 꼬리 반응으로 힘의 변화를 비교할게요." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich werde Kraft durch Körperausdehnung und Dochtreaktionen vergleichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I’ll compare strength through body expansion and wick reactions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compararé la fuerza a través de la expansión del cuerpo y las reacciones de la mecha."
