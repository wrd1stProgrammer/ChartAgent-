    "정답을 약속하는 대신, 반복할 수 있는 검증 순서를 만듭니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anstatt Sicherheit zu versprechen, bauen wir einen wiederholbaren Verifizierungsprozess auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instead of promising certainty, we build a repeatable verification process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lugar de prometer certeza, construimos un proceso de verificación repetible."
