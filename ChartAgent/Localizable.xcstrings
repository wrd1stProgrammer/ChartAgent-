            "state" : "translated",
            "value" : "Upload a chart, watch the council, then ask for the evidence you need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargue un gráfico, observe el consejo y luego solicite la evidencia que necesita."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
