          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq agents analysent indépendamment, se défient mutuellement\net ne laissent que des conditions exploitables dans un seul rapport."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq agents analysent indépendamment, se défient mutuellement\net ne laissent que des conditions exploitables dans un seul rapport."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lima agen menganalisis secara independen, menantang satu sama lain,\ndan hanya menyisakan kondisi yang dapat ditindaklanjuti dalam satu laporan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinque agenti analizzano in modo indipendente, si sfidano a vicenda\ne lasciano solo le condizioni utilizzabili in un rapporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 人のエージェントが個別に分析し、互いに挑戦し\n、実行可能な条件のみを 1 つのレポートに残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
