    "캡처 안의 고점·저점 배열을 HH·HL·LH·LL 구조로 분류하고, 추세 지속과 전환을 가르는 다음 가격 조건을 제시합니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klassifiziert sichtbare Hochs und Tiefs als HH, HL, LH und LL und definiert dann die nächste Bedingung, die Fortsetzung von Umkehr trennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifies visible highs and lows as HH, HL, LH, and LL, then defines the next condition separating continuation from reversal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasifica los máximos y mínimos visibles como HH, HL, LH y LL, luego define la siguiente condición que separa la continuación de la reversión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasifica los máximos y mínimos visibles como HH, HL, LH y LL, luego define la siguiente condición que separa la continuación de la reversión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifie les hauts et les bas visibles comme HH, HL, LH et LL, puis définit la condition suivante séparant la continuation de l'inversion."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifie les hauts et les bas visibles comme HH, HL, LH et LL, puis définit la condition suivante séparant la continuation de l'inversion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengklasifikasikan harga tertinggi dan terendah yang terlihat sebagai HH, HL, LH, dan LL, lalu menentukan kondisi berikutnya yang memisahkan kelanjutan dari pembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifica i massimi e i minimi visibili come HH, HL, LH e LL, quindi definisce la condizione successiva che separa la continuazione dall'inversione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目に見える高値と安値を HH、HL、LH、LL として分類し、継続と反転を分ける次の条件を定義します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캡처 안의 고점·저점 배열을 HH·HL·LH·LL 구조로 분류하고, 추세 지속과 전환을 가르는 다음 가격 조건을 제시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifica máximos e mínimos visíveis como HH, HL, LH e LL e, em seguida, define a próxima condição que separa a continuação da reversão."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำแนกประเภทเสียงสูงและเสียงต่ำที่มองเห็นได้เป็น HH, HL, LH และ LL จากนั้นกำหนดเงื่อนไขถัดไปที่แยกความต่อเนื่องจากการกลับตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünür yüksek ve alçak değerleri HH, HL, LH ve LL olarak sınıflandırır, ardından devamı geri dönüşten ayıran bir sonraki koşulu tanımlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân loại các mức cao và thấp có thể nhìn thấy thành HH, HL, LH và LL, sau đó xác định điều kiện tiếp theo tách sự tiếp tục và sự đảo chiều."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将可见的高点和低点分类为 HH、HL、LH 和 LL，然后定义下一个将延续与反转分开的条件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將可見的高點和低點分類為 HH、HL、LH 和 LL，然後定義下一個將延續與反轉分開的條件。"
          }
        }
      }
    },
