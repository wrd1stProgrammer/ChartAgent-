    },
    "캔들 몸통·꼬리와 반복되는 상단·하단 경계를 비교해 압축, 돌파, 재시험 패턴이 실제로 성립하는지 판정합니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht Kerzenkörper, Dochte und wiederholte Grenzen, um Kompressions-, Ausbruchs- und Wiederholungstestmuster zu überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares candle bodies, wicks, and repeated boundaries to verify compression, breakout, and retest patterns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara cuerpos de velas, mechas y límites repetidos para verificar patrones de compresión, ruptura y volver a probar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara cuerpos de velas, mechas y límites repetidos para verificar patrones de compresión, ruptura y volver a probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare les corps de bougies, les mèches et les limites répétées pour vérifier les modèles de compression, de rupture et de nouveau test."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare les corps de bougies, les mèches et les limites répétées pour vérifier les modèles de compression, de rupture et de nouveau test."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan badan candle, sumbu, dan batas berulang untuk memverifikasi pola kompresi, breakout, dan pengujian ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta i corpi delle candele, gli stoppini e i confini ripetuti per verificare i modelli di compressione, rottura e ripetizione del test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンドルの本体、芯、繰り返される境界を比較して、圧縮、ブレークアウト、および再テストのパターンを検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캔들 몸통·꼬리와 반복되는 상단·하단 경계를 비교해 압축, 돌파, 재시험 패턴이 실제로 성립하는지 판정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara corpos de velas, pavios e limites repetidos para verificar padrões de compressão, rompimento e novo teste."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบตัวแท่งเทียน ไส้ตะเกียง และขอบเขตซ้ำเพื่อตรวจสอบการบีบอัด การฝ่าวงล้อม และรูปแบบการทดสอบซ้ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıkıştırma, kopma ve yeniden test modellerini doğrulamak için mum gövdelerini, fitilleri ve tekrarlanan sınırları karşılaştırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh thân nến, bấc và các ranh giới lặp lại để xác minh các mô hình nén, đột phá và kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较烛身、影线和重复边界，以验证压缩、突破和重新测试模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
