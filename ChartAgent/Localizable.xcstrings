    "최근 스윙 고점과 저점의 순서를 먼저 맞춰볼게요." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich werde zunächst die Reihenfolge der jüngsten Hochs und Tiefs darstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I’ll map the order of recent swing highs and lows first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero trazaré el orden de los máximos y mínimos recientes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero trazaré el orden de los máximos y mínimos recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vais d’abord cartographier l’ordre des hauts et des bas récents."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vais d’abord cartographier l’ordre des hauts et des bas récents."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya akan memetakan urutan swing high dan low baru-baru ini terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per prima cosa mapperò l'ordine dei recenti massimi e minimi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず、最近のスイングの高値と安値の順序をマッピングします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 스윙 고점과 저점의 순서를 먼저 맞춰볼게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapearei primeiro a ordem dos máximos e mínimos das oscilações recentes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันจะแมปลำดับของการสวิงสูงและต่ำล่าสุดก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce son dönemdeki yükseliş ve düşüşlerin sırasını haritalandıracağım."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước tiên, tôi sẽ sắp xếp thứ tự các mức dao động cao và thấp gần đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我将首先绘制近期波动高点和低点的顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我將首先繪製近期波動高點和低點的順序。"
          }
        }
      }
    },
