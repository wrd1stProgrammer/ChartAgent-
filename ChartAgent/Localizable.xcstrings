    "같은 차트도 반론을 거치면 조건과 위험이 선명해집니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herausforderungen machen die Bedingungen und Risiken deutlicher – sogar im selben Diagramm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Challenges make the conditions and risks clearer—even on the same chart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los desafíos aclaran las condiciones y los riesgos, incluso en el mismo gráfico."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los desafíos aclaran las condiciones y los riesgos, incluso en el mismo gráfico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les défis rendent les conditions et les risques plus clairs, même sur le même graphique."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les défis rendent les conditions et les risques plus clairs, même sur le même graphique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantangan membuat kondisi dan risiko menjadi lebih jelas—bahkan pada grafik yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sfide rendono le condizioni e i rischi più chiari, anche sullo stesso grafico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャレンジにより、同じチャート上であっても状況とリスクがより明確になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 차트도 반론을 거치면 조건과 위험이 선명해집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os desafios tornam as condições e os riscos mais claros – mesmo no mesmo gráfico."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความท้าทายทำให้เงื่อนไขและความเสี่ยงชัดเจนยิ่งขึ้น—แม้จะอยู่ในแผนภูมิเดียวกันก็ตาม"
