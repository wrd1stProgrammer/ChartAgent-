    "돌파 실패, 유동성 스윕, 재진입 같은 실패 패턴을 찾아 기본 시나리오가 뒤집히는 반대 조건을 한 가지로 압축합니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet fehlgeschlagene Ausbrüche, Sweeps und Wiedereintritte und komprimiert dann den gegnerischen Fall in eine Umkehrbedingung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds failed breakouts, sweeps, and re-entries, then compresses the opposing case into one reversal condition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra fugas, barridos y reingresos fallidos y luego comprime el caso contrario en una condición de reversión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra fugas, barridos y reingresos fallidos y luego comprime el caso contrario en una condición de reversión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte les échecs, les balayages et les rentrées, puis compresse le cas opposé en une seule condition d'inversion."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte les échecs, les balayages et les rentrées, puis compresse le cas opposé en une seule condition d'inversion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menemukan breakout, sapuan, dan entri ulang yang gagal, lalu memampatkan kasus lawan menjadi satu kondisi pembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova breakout, spazzate e rientri falliti, quindi comprime il caso avversario in una condizione di inversione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗したブレイクアウト、スイープ、リエントリーを見つけて、相手のケースを 1 つの逆転条件に圧縮します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌파 실패, 유동성 스윕, 재진입 같은 실패 패턴을 찾아 기본 시나리오가 뒤집히는 반대 조건을 한 가지로 압축합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra fugas, varreduras e reentradas com falha e, em seguida, compacta o caso oposto em uma condição de reversão."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหาการทะลุ การกวาด และการกลับรายการล้มเหลว จากนั้นบีบอัดเคสของฝ่ายตรงข้ามให้เป็นเงื่อนไขการกลับรายการเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başarısız çıkışları, taramaları ve yeniden girişleri bulur, ardından karşıt durumu tek bir tersine çevirme koşuluna sıkıştırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm các đột phá, quét và nhập lại không thành công, sau đó nén trường hợp đối lập thành một điều kiện đảo ngược."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现失败的突破、横扫和重新进入，然后将相反的情况压缩为一种反转条件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發現失敗的突破、橫掃和重新進入，然後將相反的情況壓縮為一種反轉條件。"
          }
        }
      }
    },
